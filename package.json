    "gt-react": "11.4.12",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.6",
    "recharts": "3.10.1",
