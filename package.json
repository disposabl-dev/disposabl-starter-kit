{
  "name": "disposabl-starter-kit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "bun --check && turbo run check",
    "check-types": "bun run check",
    "typecheck": "bun run check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "2.11.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workos-authkit": "0.2.10",
    "@generaltranslation/react-core-linter": "0.1.15",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@workos-inc/authkit-react": "0.16.3",
    "@workos-inc/node": "10.14.0",
    "convex": "1.46.0",
    "eslint": "10.12.0",
    "gt": "2.26.3",
    "gt-react": "11.4.11",
    "lucide-react": "1.56.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
