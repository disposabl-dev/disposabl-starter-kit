{
  "name": "disposabl-starter-kit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4-canary.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "check": "bun check .",
    "fmt": "bun fmt",
    "lint": "bun lint",
    "validate": "bun run lint --fix --max-warnings 0 && bun run fmt && bun run check",
    "validate:check": "bun run lint --max-warnings 0 && bun run fmt --check && bun run check",
    "prepare": "git config --local core.hooksPath .githooks",
    "dev": "turbo dev",
    "build": "turbo build"
  },
  "devDependencies": {
    "@disposabl/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "1.4.3",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "@tanstack/react-start": "1.169.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "embla-carousel-react": "8.6.0",
    "gt-react": "11.4.12",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.6",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "tw-animate-css": "1.4.0",
    "shadcn": "4.22.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-is": "19.3.0",
    "@tanstack/react-router": "1.170.45",
    "gt-tanstack-start": "11.4.12",
    "gt": "2.26.5",
    "generaltranslation": "9.5.7"
  },
  "catalogs": {
    "typescript6": {
      "typescript": "6.0.3"
    }
  }
}
