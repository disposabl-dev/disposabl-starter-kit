{
  "name": "disposabl-starter-kit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4-canary.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "check": "bun check .",
    "fmt": "bun fmt",
    "lint": "bun lint",
    "validate": "bun run lint --fix --max-warnings 0 && bun run fmt && bun run check",
    "validate:check": "bun run lint --max-warnings 0 && bun run fmt --check && bun run check",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@disposabl/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "1.4.3",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "@tanstack/react-start": "1.169.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  },
  "catalogs": {
    "typescript6": {
      "typescript": "6.0.3"
    }
  }
}
