{
  "name": "disposabl-starter-kit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "bun --check && turbo run check",
    "check-types": "bun run check",
    "typecheck": "bun run check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "2.11.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@generaltranslation/react-core-linter": "0.1.15",
    "@types/bun": "1.4.3",
    "eslint": "10.12.0",
    "prettier": "^3.9.10"
  }
}
