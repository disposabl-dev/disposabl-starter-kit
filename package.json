{
  "name": "disposabl-starter-kit",
  "private": true,
  "scripts": {
    "check": "bun check .",
    "fmt": "bun fmt",
    "lint": "bun lint",
    "validate": "bun run lint --fix --max-warnings 0 && bun run fmt && bun run check",
    "validate:check": "bun run lint --max-warnings 0 && bun run fmt --check && bun run check",
    "prepare": "git config --local core.hooksPath .githooks",
    "dev": "turbo dev",
    "build": "turbo build",
    "generate:platforms": "bun run --filter @disposabl/backend generate:platforms"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4-canary.1",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@disposabl/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "catalog": {
    "@unpic/react": "1.0.2",
    "@convex-dev/r2": "0.10.4",
    "tinify": "1.8.3",
    "@types/bun": "1.4.3",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "@tanstack/react-start": "1.169.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
