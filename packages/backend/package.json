{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:convex generate-platforms",
    "dev:convex": "convex dev",
    "generate-platforms": "bun --watch --no-clear-screen node_modules/disposabl-kit/src/generate-platforms.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "bun check"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "catalog:",
    "@convex-dev/workos-authkit": "catalog:",
    "convex": "catalog:",
    "disposabl-kit": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@workos-inc/node": "catalog:",
    "convex-test": "0.0.61",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    }
  }
}
