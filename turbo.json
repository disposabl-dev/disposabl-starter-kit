{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    "globalDependencies": ["bunfig.toml"],
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
        "outputs": ["dist/**"]
      },
      "format": {
        "cache": false
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "typecheck": {
        "dependsOn": ["^typecheck"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "test": {
        "dependsOn": ["^test"]
      }
    }
  }
  